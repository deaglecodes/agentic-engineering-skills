diff --git a/app.py b/app.py
index f1d4f23..be6a9f9 100644
--- a/app.py
+++ b/app.py
@@ -2,0 +3 @@ import base64
+import binascii
@@ -3,0 +5,19 @@ import json
+from datetime import datetime, timedelta
+
+
+def _decode_cursor(cursor, team):
+    try:
+        if not isinstance(cursor, str):
+            raise ValueError
+        payload = json.loads(base64.b64decode(cursor.encode("ascii"), altchars=b"-_", validate=True))
+        if not isinstance(payload, dict) or set(payload) != {"created_at", "id", "team"}:
+            raise ValueError
+        if not all(isinstance(value, str) for value in payload.values()):
+            raise ValueError
+        stamp = payload["created_at"]
+        parsed = datetime.fromisoformat(stamp[:-1] + "+00:00" if stamp.endswith("Z") else stamp)
+        if "T" not in stamp or parsed.utcoffset() != timedelta(0) or payload["team"] != team:
+            raise ValueError
+        return stamp, payload["id"]
+    except (ValueError, TypeError, UnicodeError, binascii.Error) as exc:
+        raise ValueError("Invalid cursor for this team") from exc
@@ -7,4 +27,10 @@ def list_events(events, team, limit=2, cursor=None):
-    rows = sorted([e for e in events if e["team"] == team], key=lambda e: e["created_at"], reverse=True)
-    if cursor:
-        stamp = json.loads(base64.urlsafe_b64decode(cursor.encode()))["created_at"]
-        rows = [e for e in rows if e["created_at"] < stamp]
+    if isinstance(limit, bool) or not isinstance(limit, int) or not 1 <= limit <= 100:
+        raise ValueError("Limit must be an integer from 1 through 100")
+    anchor = _decode_cursor(cursor, team) if cursor is not None else None
+    rows = sorted(
+        [e for e in events if e["team"] == team],
+        key=lambda e: (e["created_at"], e["id"]),
+        reverse=True,
+    )
+    if anchor is not None:
+        rows = [e for e in rows if (e["created_at"], e["id"]) < anchor]
@@ -14 +40,3 @@ def list_events(events, team, limit=2, cursor=None):
-        next_cursor = base64.urlsafe_b64encode(json.dumps({"created_at": page[-1]["created_at"]}).encode()).decode()
+        next_cursor = base64.urlsafe_b64encode(json.dumps({
+            "created_at": page[-1]["created_at"], "id": page[-1]["id"], "team": team,
+        }).encode()).decode()
diff --git a/test_app.py b/test_app.py
index cd058ed..ec53181 100644
--- a/test_app.py
+++ b/test_app.py
@@ -1,0 +2,3 @@ import unittest
+import base64
+import copy
+import json
@@ -13,0 +17,70 @@ class VisibleTests(unittest.TestCase):
+
+    def tied_rows(self):
+        return [
+            {"id": event_id, "team": "A", "created_at": "2026-01-02T00:00:00Z"}
+            for event_id in ["2", "10", "a", "9", "b"]
+        ] + [
+            {"id": "older", "team": "A", "created_at": "2026-01-01T00:00:00Z"},
+            {"id": "other", "team": "B", "created_at": "2026-01-03T00:00:00Z"},
+        ]
+
+    def test_ties_across_pages_and_no_mutation(self):
+        rows = self.tied_rows()
+        original = copy.deepcopy(rows)
+        for limit in [1, 2, 3, 5, 6, 100]:
+            with self.subTest(limit=limit):
+                cursor = None
+                ids = []
+                for _ in range(len(rows) + 1):
+                    result = list_events(rows, "A", limit, cursor)
+                    ids.extend(row["id"] for row in result["items"])
+                    cursor = result["next_cursor"]
+                    if cursor is None:
+                        break
+                    self.assertEqual(len(result["items"]), limit)
+                    self.assertLess(len(ids), 6)
+                else:
+                    self.fail("Pagination did not terminate")
+                self.assertEqual(ids, ["b", "a", "9", "2", "10", "older"])
+        self.assertEqual(rows, original)
+
+    def test_deleted_anchor(self):
+        rows = self.tied_rows()
+        first = list_events(rows, "A")
+        rows = [row for row in rows if row["id"] != first["items"][-1]["id"]]
+        second = list_events(rows, "A", cursor=first["next_cursor"])
+        self.assertEqual([row["id"] for row in second["items"]], ["9", "2"])
+        last = list_events(rows, "A", cursor=second["next_cursor"])
+        self.assertEqual([row["id"] for row in last["items"]], ["10", "older"])
+        self.assertIsNone(last["next_cursor"])
+        self.assertEqual(list_events([], "A", cursor=first["next_cursor"]),
+                         {"items": [], "next_cursor": None})
+
+    def test_invalid_limits(self):
+        for limit in [True, False, 0, -1, 101, 1.0, "2", None, [], {}]:
+            with self.subTest(limit=limit), self.assertRaises(ValueError):
+                list_events([], "A", limit=limit)
+
+    def test_invalid_cursors(self):
+        def encode(payload):
+            return base64.urlsafe_b64encode(json.dumps(payload).encode()).decode()
+
+        valid = {"created_at": "2026-01-02T00:00:00Z", "id": "a", "team": "A"}
+        invalid = ["", "!not-base64!", "é", 0, False, [], {}, b"e30=",
+                   base64.urlsafe_b64encode(b"not json").decode(),
+                   base64.urlsafe_b64encode(b"\xff").decode()]
+        invalid.extend(encode(payload) for payload in [None, [], "text", {},
+            {"created_at": valid["created_at"]},
+            {**valid, "team": "B"}, {**valid, "id": 2},
+            {**valid, "created_at": None}, {**valid, "created_at": "bad"},
+            {**valid, "created_at": "2026-01-02T00:00:00"},
+            {**valid, "extra": "unexpected"},
+        ])
+        for cursor in invalid:
+            with self.subTest(cursor=cursor), self.assertRaises(ValueError):
+                list_events([], "A", cursor=cursor)
+
+    def test_cursor_cannot_cross_teams(self):
+        cursor = list_events(self.tied_rows(), "A")["next_cursor"]
+        with self.assertRaises(ValueError):
+            list_events(self.tied_rows(), "B", cursor=cursor)
