diff --git a/app.py b/app.py
index 76fa0cb..08e0340 100644
--- a/app.py
+++ b/app.py
@@ -2,0 +3,18 @@
+from decimal import Context, Decimal, InvalidOperation, ROUND_HALF_UP, localcontext
+
+
+_CENT = Decimal("0.01")
+
+
+def _decimal(value):
+    if not isinstance(value, (str, Decimal)):
+        raise ValueError("Money values and tax_rate must be decimal strings or Decimal")
+    try:
+        value = Decimal(value)
+    except InvalidOperation as exc:
+        raise ValueError("Invalid decimal value") from exc
+    if not value.is_finite() or value < 0:
+        raise ValueError("Money values and tax_rate must be finite and nonnegative")
+    # Normalize signed zero so monetary output always uses 0.00.
+    return value if value else Decimal(0)
+
@@ -5,6 +23,29 @@ def build_invoice(lines, discount="0", tax_rate="0"):
-    subtotal = round(sum(float(line["unit_price"]) * line["quantity"] for line in lines), 2)
-    discount = float(discount)
-    taxable = max(0, subtotal - discount)
-    tax = round(taxable * float(tax_rate), 2)
-    return {"subtotal": f"{subtotal:.2f}", "discount": f"{discount:.2f}",
-            "tax": f"{tax:.2f}", "total": f"{taxable + tax:.2f}"}
+    discount = _decimal(discount)
+    tax_rate = _decimal(tax_rate)
+    parsed_lines = []
+    try:
+        for line in lines:
+            price = _decimal(line["unit_price"])
+            quantity = line["quantity"]
+            if isinstance(quantity, bool) or not isinstance(quantity, int) or quantity <= 0:
+                raise ValueError("Quantity must be a positive integer")
+            parsed_lines.append((price, Decimal(quantity)))
+    except (KeyError, TypeError) as exc:
+        raise ValueError("Lines must contain unit_price and quantity") from exc
+
+    # Allow exact intermediate arithmetic, including values beyond the default
+    # 28-digit precision, without depending on the caller's decimal context.
+    values = [discount, tax_rate]
+    values.extend(value for line in parsed_lines for value in line)
+    precision = 10 + sum(len(value.as_tuple().digits) + abs(value.as_tuple().exponent)
+                         for value in values)
+    with localcontext(Context(prec=precision, rounding=ROUND_HALF_UP)):
+        subtotal = sum(( (price * quantity).quantize(_CENT)
+                         for price, quantity in parsed_lines), Decimal("0.00"))
+        discount = discount.quantize(_CENT)
+        if discount > subtotal:
+            raise ValueError("Discount must not exceed subtotal")
+        taxable = subtotal - discount
+        tax = (taxable * tax_rate).quantize(_CENT)
+        return {"subtotal": f"{subtotal:.2f}", "discount": f"{discount:.2f}",
+                "tax": f"{tax:.2f}", "total": f"{taxable + tax:.2f}"}
diff --git a/test_app.py b/test_app.py
index 7b45ae3..e65bfc4 100644
--- a/test_app.py
+++ b/test_app.py
@@ -11,0 +12,71 @@ class VisibleTests(unittest.TestCase):
+
+
+class RoundingContractTests(unittest.TestCase):
+    def test_rounds_extended_lines_before_summing(self):
+        self.assertEqual(build_invoice([
+            {"unit_price": "0.335", "quantity": 3},
+            {"unit_price": "0.005", "quantity": 1},
+        ]), {"subtotal": "1.02", "discount": "0.00", "tax": "0.00", "total": "1.02"})
+
+    def test_discount_and_tax_round_half_up(self):
+        self.assertEqual(build_invoice(
+            [{"unit_price": "1.00", "quantity": 1}], "0.045", "0.10"),
+            {"subtotal": "1.00", "discount": "0.05", "tax": "0.10", "total": "1.05"})
+
+    def test_decimal_inputs_and_no_mutation(self):
+        from copy import deepcopy
+        from decimal import Decimal
+        lines = [{"unit_price": Decimal("2.675"), "quantity": 1}]
+        original = deepcopy(lines)
+        self.assertEqual(build_invoice(lines, Decimal("0"), Decimal("0"))["total"], "2.68")
+        self.assertEqual(lines, original)
+
+    def test_discount_limit_uses_rounded_discount(self):
+        lines = [{"unit_price": "1", "quantity": 1}]
+        self.assertEqual(build_invoice(lines, "1.004")["total"], "0.00")
+        for discount in ("1.005", "2"):
+            with self.subTest(discount=discount), self.assertRaises(ValueError):
+                build_invoice(lines, discount)
+        with self.assertRaises(ValueError):
+            build_invoice([], "0.01")
+
+    def test_invalid_decimal_values(self):
+        from decimal import Decimal
+        for value in ("-0.001", "NaN", "sNaN", "Infinity", "-Infinity", "bad", "",
+                      Decimal("NaN"), Decimal("-1"), None, True, 0.1):
+            for field in ("unit_price", "discount", "tax_rate"):
+                with self.subTest(value=value, field=field), self.assertRaises(ValueError):
+                    line = {"unit_price": "1", "quantity": 1}
+                    kwargs = {}
+                    if field == "unit_price":
+                        line[field] = value
+                    else:
+                        kwargs[field] = value
+                    build_invoice([line], **kwargs)
+
+    def test_invalid_quantities(self):
+        for quantity in (True, False, 0, -1, 1.5, "2", None):
+            with self.subTest(quantity=quantity), self.assertRaises(ValueError):
+                build_invoice([{"unit_price": "1", "quantity": quantity}])
+
+    def test_malformed_lines(self):
+        for lines in (None, [None], [{}], [{"unit_price": "1"}]):
+            with self.subTest(lines=lines), self.assertRaises(ValueError):
+                build_invoice(lines)
+
+    def test_signed_zero_and_empty_output(self):
+        self.assertEqual(build_invoice([], "-0", "-0"),
+                         {"subtotal": "0.00", "discount": "0.00", "tax": "0.00", "total": "0.00"})
+
+    def test_large_values_ignore_callers_precision(self):
+        from decimal import localcontext
+        with localcontext() as context:
+            context.prec = 3
+            result = build_invoice([
+                {"unit_price": "123456789012345678901234567890.125", "quantity": 2}
+            ], "0.005", "0.1")
+        self.assertEqual(result, {
+            "subtotal": "246913578024691357802469135780.25",
+            "discount": "0.01", "tax": "24691357802469135780246913578.02",
+            "total": "271604935827160493582716049358.26",
+        })
