-    rows = sorted([e for e in events if e["team"] == team], key=lambda e: e["created_at"], reverse=True)
-    if cursor:
-        stamp = json.loads(base64.urlsafe_b64decode(cursor.encode()))["created_at"]
-        rows = [e for e in rows if e["created_at"] < stamp]
+    if isinstance(limit, bool) or not isinstance(limit, int) or not 1 <= limit <= 100:
+        raise ValueError("Limit must be an integer from 1 through 100")
+    anchor = _decode_cursor(cursor, team) if cursor is not None else None
+    rows = sorted(
+        [e for e in events if e["team"] == team],
+        key=lambda e: (e["created_at"], e["id"]),
+        reverse=True,
+    )
+    if anchor is not None:
+        rows = [e for e in rows if (e["created_at"], e["id"]) < anchor]
@@ -14 +40,5 @@ def list_events(events, team, limit=2, cursor=None):
