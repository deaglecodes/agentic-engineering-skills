diff --git a/app.py b/app.py
index 76fa0cb..08132a9 100644
--- a/app.py
+++ b/app.py
@@ -2,0 +3,17 @@
+from decimal import Decimal, InvalidOperation, ROUND_HALF_UP, localcontext
+
+
+_CENT = Decimal("0.01")
+
+
+def _decimal(value):
+    if not isinstance(value, (str, Decimal)):
+        raise ValueError("Money values and tax_rate must be decimal strings or Decimal")
+    try:
+        value = Decimal(value)
+    except InvalidOperation as error:
+        raise ValueError("Invalid decimal value") from error
+    if not value.is_finite() or value < 0:
+        raise ValueError("Money values and tax_rate must be finite and nonnegative")
+    return value.copy_abs()  # Normalize negative zero.
+
@@ -5,6 +22,29 @@ def build_invoice(lines, discount="0", tax_rate="0"):
-    subtotal = round(sum(float(line["unit_price"]) * line["quantity"] for line in lines), 2)
-    discount = float(discount)
-    taxable = max(0, subtotal - discount)
-    tax = round(taxable * float(tax_rate), 2)
-    return {"subtotal": f"{subtotal:.2f}", "discount": f"{discount:.2f}",
-            "tax": f"{tax:.2f}", "total": f"{taxable + tax:.2f}"}
+    prices = []
+    try:
+        for line in lines:
+            price = _decimal(line["unit_price"])
+            quantity = line["quantity"]
+            if isinstance(quantity, bool) or not isinstance(quantity, int) or quantity <= 0:
+                raise ValueError("Quantity must be a positive integer")
+            prices.append((price, Decimal(quantity)))
+    except (TypeError, KeyError) as error:
+        raise ValueError("Invalid invoice lines") from error
+    discount = _decimal(discount)
+    tax_rate = _decimal(tax_rate)
+
+    # Allow exact intermediate arithmetic even beyond the caller's precision.
+    values = [discount, tax_rate] + [value for pair in prices for value in pair]
+    precision = 10 + sum(len(value.as_tuple().digits) + abs(value.as_tuple().exponent)
+                         for value in values)
+    with localcontext() as context:
+        context.prec = max(28, precision)
+        context.rounding = ROUND_HALF_UP
+        subtotal = sum((price * quantity).quantize(_CENT) for price, quantity in prices)
+        subtotal = Decimal(subtotal).quantize(_CENT)
+        discount = discount.quantize(_CENT)
+        if discount > subtotal:
+            raise ValueError("Discount must not exceed subtotal")
+        taxable = subtotal - discount
+        tax = (taxable * tax_rate).quantize(_CENT)
+        return {"subtotal": f"{subtotal:.2f}", "discount": f"{discount:.2f}",
+                "tax": f"{tax:.2f}", "total": f"{taxable + tax:.2f}"}
diff --git a/test_app.py b/test_app.py
index 7b45ae3..c75a8e6 100644
--- a/test_app.py
+++ b/test_app.py
@@ -11,0 +12,66 @@ class VisibleTests(unittest.TestCase):
+
+
+class ContractTests(unittest.TestCase):
+    def test_round_each_extended_line_half_up(self):
+        self.assertEqual(build_invoice([
+            {"unit_price": "0.005", "quantity": 1},
+            {"unit_price": "0.005", "quantity": 3},
+        ]), {"subtotal": "0.03", "discount": "0.00", "tax": "0.00", "total": "0.03"})
+
+    def test_discount_and_tax_half_up(self):
+        self.assertEqual(build_invoice([{"unit_price": "1.005", "quantity": 1}],
+                                      "0.105", "0.05"),
+                         {"subtotal": "1.01", "discount": "0.11", "tax": "0.05", "total": "0.95"})
+
+    def test_decimal_inputs_and_no_mutation(self):
+        from copy import deepcopy
+        from decimal import Decimal
+        lines = [{"unit_price": Decimal("2.675"), "quantity": 2}]
+        original = deepcopy(lines)
+        self.assertEqual(build_invoice(lines, Decimal("0"), Decimal("0"))["total"], "5.35")
+        self.assertEqual(lines, original)
+
+    def test_large_amount_with_low_context_precision(self):
+        from decimal import localcontext
+        with localcontext() as context:
+            context.prec = 6
+            self.assertEqual(build_invoice([
+                {"unit_price": "123456789012345678901234567890.005", "quantity": 1}
+            ])["total"], "123456789012345678901234567890.01")
+            self.assertEqual(context.prec, 6)
+
+    def test_invalid_money_and_rates(self):
+        for value in ("-0.001", "NaN", "sNaN", "Infinity", "-Infinity", "bad", None, True, 0.1):
+            for field in ("unit_price", "discount", "tax_rate"):
+                with self.subTest(value=value, field=field), self.assertRaises(ValueError):
+                    line = {"unit_price": "10", "quantity": 1}
+                    kwargs = {}
+                    if field == "unit_price":
+                        line[field] = value
+                    else:
+                        kwargs[field] = value
+                    build_invoice([line], **kwargs)
+
+    def test_invalid_quantities(self):
+        from decimal import Decimal
+        for quantity in (True, False, 0, -1, 1.5, "2", None, Decimal("2")):
+            with self.subTest(quantity=quantity), self.assertRaises(ValueError):
+                build_invoice([{"unit_price": "1", "quantity": quantity}])
+
+    def test_discount_limit_applies_after_rounding(self):
+        lines = [{"unit_price": "1", "quantity": 1}]
+        self.assertEqual(build_invoice(lines, "1.004")["total"], "0.00")
+        for discount in ("1.005", "2"):
+            with self.subTest(discount=discount), self.assertRaises(ValueError):
+                build_invoice(lines, discount)
+        with self.assertRaises(ValueError):
+            build_invoice([], "0.01")
+
+    def test_zero_and_empty_invoice_fields(self):
+        self.assertEqual(build_invoice([], "-0", "-0"),
+                         {"subtotal": "0.00", "discount": "0.00", "tax": "0.00", "total": "0.00"})
+
+    def test_invalid_line_structure(self):
+        for lines in (None, [None], [{}], [{"unit_price": "1"}]):
+            with self.subTest(lines=lines), self.assertRaises(ValueError):
+                build_invoice(lines)
