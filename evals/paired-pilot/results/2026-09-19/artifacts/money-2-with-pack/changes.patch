diff --git a/app.py b/app.py
index 76fa0cb..e46b5f9 100644
--- a/app.py
+++ b/app.py
@@ -2,0 +3,14 @@
+from decimal import Decimal, InvalidOperation, ROUND_HALF_UP, localcontext
+
+
+def _decimal(value):
+    if not isinstance(value, (str, Decimal)):
+        raise ValueError("Money values and tax_rate must be decimal strings or Decimals")
+    try:
+        result = Decimal(value)
+    except InvalidOperation as exc:
+        raise ValueError("Invalid decimal value") from exc
+    if not result.is_finite() or result < 0:
+        raise ValueError("Money values and tax_rate must be finite and nonnegative")
+    return result.copy_abs()  # Normalize signed zero.
+
@@ -5,6 +19,32 @@ def build_invoice(lines, discount="0", tax_rate="0"):
-    subtotal = round(sum(float(line["unit_price"]) * line["quantity"] for line in lines), 2)
-    discount = float(discount)
-    taxable = max(0, subtotal - discount)
-    tax = round(taxable * float(tax_rate), 2)
-    return {"subtotal": f"{subtotal:.2f}", "discount": f"{discount:.2f}",
-            "tax": f"{tax:.2f}", "total": f"{taxable + tax:.2f}"}
+    discount = _decimal(discount)
+    tax_rate = _decimal(tax_rate)
+    items = []
+    try:
+        for line in lines:
+            price = _decimal(line["unit_price"])
+            quantity = line["quantity"]
+            if isinstance(quantity, bool) or not isinstance(quantity, int) or quantity <= 0:
+                raise ValueError("Quantity must be a positive integer")
+            items.append((price, quantity))
+    except (KeyError, TypeError) as exc:
+        raise ValueError("Invalid invoice lines") from exc
+
+    # Reserve enough digits for exact products and sums before cent rounding,
+    # including when callers have changed the ambient decimal precision.
+    values = [discount, tax_rate] + [price for price, _ in items]
+    precision = 4 + sum(len(value.as_tuple().digits) + abs(value.as_tuple().exponent)
+                        for value in values)
+    precision += sum(len(str(quantity)) for _, quantity in items)
+    cents = Decimal("0.01")
+    with localcontext() as context:
+        context.prec = max(28, precision)
+        context.rounding = ROUND_HALF_UP
+        subtotal = sum(((price * quantity).quantize(cents) for price, quantity in items),
+                       Decimal("0.00"))
+        discount = discount.quantize(cents)
+        if discount > subtotal:
+            raise ValueError("Discount must not exceed subtotal")
+        taxable = subtotal - discount
+        tax = (taxable * tax_rate).quantize(cents)
+        return {"subtotal": f"{subtotal:.2f}", "discount": f"{discount:.2f}",
+                "tax": f"{tax:.2f}", "total": f"{taxable + tax:.2f}"}
diff --git a/test_app.py b/test_app.py
index 7b45ae3..60303e3 100644
--- a/test_app.py
+++ b/test_app.py
@@ -1,0 +2,2 @@ import unittest
+from copy import deepcopy
+from decimal import Decimal, localcontext
@@ -11,0 +14,60 @@ class VisibleTests(unittest.TestCase):
+
+    def test_round_extended_lines_before_summing(self):
+        self.assertEqual(build_invoice([
+            {"unit_price": "0.335", "quantity": 3},
+            {"unit_price": "0.005", "quantity": 1},
+        ]), {"subtotal": "1.02", "discount": "0.00", "tax": "0.00", "total": "1.02"})
+
+    def test_discount_and_tax_round_half_up(self):
+        self.assertEqual(build_invoice([{"unit_price": "1.00", "quantity": 1}],
+                                       "0.045", "0.10"),
+                         {"subtotal": "1.00", "discount": "0.05",
+                          "tax": "0.10", "total": "1.05"})
+
+    def test_decimal_inputs_and_no_mutation(self):
+        lines = [{"unit_price": Decimal("2.675"), "quantity": 1}]
+        original = deepcopy(lines)
+        self.assertEqual(build_invoice(lines, Decimal("0"), Decimal("0"))["total"], "2.68")
+        self.assertEqual(lines, original)
+
+    def test_invalid_money_and_rates(self):
+        for value in ("bad", "NaN", "sNaN", "Infinity", "-Infinity", "-0.001",
+                      Decimal("NaN"), Decimal("-1"), None, True, 0.1):
+            for field in ("unit_price", "discount", "tax_rate"):
+                with self.subTest(value=value, field=field), self.assertRaises(ValueError):
+                    line = {"unit_price": "1", "quantity": 1}
+                    kwargs = {}
+                    if field == "unit_price":
+                        line[field] = value
+                    else:
+                        kwargs[field] = value
+                    build_invoice([line], **kwargs)
+
+    def test_invalid_quantities(self):
+        for quantity in (True, False, 0, -1, 1.5, "2", Decimal("2"), None):
+            with self.subTest(quantity=quantity), self.assertRaises(ValueError):
+                build_invoice([{"unit_price": "1", "quantity": quantity}])
+
+    def test_malformed_lines(self):
+        for lines in (None, [None], [{}], [{"unit_price": "1"}]):
+            with self.subTest(lines=lines), self.assertRaises(ValueError):
+                build_invoice(lines)
+
+    def test_discount_limit_uses_rounded_cents(self):
+        lines = [{"unit_price": "1", "quantity": 1}]
+        self.assertEqual(build_invoice(lines, "1.004", "0.2")["total"], "0.00")
+        for items, discount in ((lines, "1.005"), ([], "0.01")):
+            with self.subTest(discount=discount), self.assertRaises(ValueError):
+                build_invoice(items, discount)
+
+    def test_large_values_and_ambient_precision(self):
+        with localcontext() as context:
+            context.prec = 6
+            self.assertEqual(build_invoice([
+                {"unit_price": "123456789012345678901234567890.005", "quantity": 1}
+            ])["total"], "123456789012345678901234567890.01")
+            self.assertEqual(context.prec, 6)
+
+    def test_signed_zero_is_formatted_as_zero(self):
+        self.assertEqual(build_invoice([{"unit_price": "-0", "quantity": 1}], "-0", "-0"),
+                         dict.fromkeys(("subtotal", "discount", "tax", "total"), "0.00"))
